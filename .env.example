# ===================== 应用 =====================
# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
# 上传大小上限（MB）
MAX_UPLOAD_SIZE_MB=100
# 单次批量上传的文件数上限
MAX_BATCH_FILES=20
# CORS 允许来源，逗号分隔；默认 * 表示全部
CORS_ORIGINS=*

# ===================== 目录 =====================
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db
LOG_DIR=./logs
REGISTRY_FILE=./registry.json
GROUPS_FILE=./groups.json

# ===================== Qwen =====================
# 兼容 OpenAI SDK 的接口地址与密钥
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4

# ===================== DeepSeek（查询改写） =====================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===================== 分块 =====================
# 单块最大 token 数（超长块按滑动窗口切分）
CHUNK_MAX_TOKENS=512
# 滑动窗口重叠比例（0 ~ 0.5）
CHUNK_OVERLAP_RATIO=0.15

# ===================== 查询改写 =====================
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_COUNT=2
# 改写查询与原始查询的相似度阈值（低于则丢弃）
QUERY_SIMILARITY_THRESHOLD=0.75

# ===================== 知识图谱 =====================
KG_ENABLED=true

# ===================== 检索 =====================
# 每路召回候选深度（RRF 融合后再按请求 top_k 返回）
RETRIEVAL_CANDIDATE_K=20
# BM25 稀疏检索路开关
BM25_ENABLED=true
# 章节/目录类查询路由：只保留同义改写并加入原始查询
CHAPTER_QUERY_ROUTING=true
# 低置信度拒绝阈值（0-1，设为 0 关闭拒绝）
ANSWER_CONFIDENCE_THRESHOLD=0.55
# LLM 二阶段重排（仅概念/定义类查询）
LLM_RERANK_ENABLED=true
LLM_RERANK_TOP_N=20
# LLM 答案生成
ANSWER_TEMPERATURE=0.3
ANSWER_MAX_TOKENS=1024

# ===================== 子块 =====================
SUBCHUNK_ENABLED=true
SUBCHUNK_MAX_TOKENS=160

# ===================== PaddleOCR =====================
PADDLEOCR_API_KEY=
# SDK 会自动拼接 /api/v2/ocr/jobs，这里只需填服务根地址
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
